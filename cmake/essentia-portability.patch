-// Clang/LLVM implementation
-#if defined(__clang__) || defined(__EMSCRIPTEN__)
+// Microsoft STL (including clang-cl). Preserve the iterator proxy in Debug.
+#if defined(_MSVC_STL_VERSION)
+
+template <typename T>
+void RogueVector<T>::setData(T* data) {
+  using Storage = std::_Vector_val<std::_Simple_types<T>>;
+  static_assert(sizeof(std::vector<T>) == sizeof(Storage) &&
+                alignof(std::vector<T>) == alignof(Storage),
+                "RogueVector requires the Microsoft STL vector storage layout");
+  auto& storage = reinterpret_cast<Storage&>(static_cast<std::vector<T>&>(*this));
+  storage._Myfirst = data;
+}
+
+template <typename T>
+void RogueVector<T>::setSize(size_t size) {
+  using Storage = std::_Vector_val<std::_Simple_types<T>>;
+  auto& storage = reinterpret_cast<Storage&>(static_cast<std::vector<T>&>(*this));
+  storage._Mylast = storage._Myend = storage._Myfirst + size;
+}
+
